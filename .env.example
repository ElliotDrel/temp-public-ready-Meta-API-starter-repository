# Example placeholders only. Never commit real values.
# Instagram API with Instagram Login (NOT Facebook Login)
INSTAGRAM_APP_ID=replace_me
INSTAGRAM_APP_SECRET=replace_me
INSTAGRAM_REDIRECT_URI=https://example.org/oauth/callback
INSTAGRAM_ACCESS_TOKEN=replace_with_long_lived_token
INSTAGRAM_USER_ID=replace_with_professional_ig_user_id
INSTAGRAM_GRAPH_API_VERSION=v25.0
INSTAGRAM_WEBHOOK_VERIFY_TOKEN=replace_with_random_shared_token
# For multi-account apps, store each credential in a real secret store, not environment variables.
# A separate app/review/token flow is required for Facebook Pages.
FACEBOOK_PAGE_ID=replace_me
FACEBOOK_PAGE_ACCESS_TOKEN=replace_me
